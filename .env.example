# Copy to `.env` (Docker Compose) or `backend/.env` (local development) and adjust.
# Never commit real secrets.

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=production            # development | test | production
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------------
# Docker Compose builds DATABASE_URL from POSTGRES_PASSWORD automatically.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# For local development without Docker, SQLite works out of the box:
# DATABASE_URL=sqlite:///./lifeos.db
# DATABASE_URL=postgresql+psycopg://lifeos:password@localhost:5432/lifeos

# --- Web / security ------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000   # used to build calendar subscription links
CORS_ORIGINS=http://localhost:5173      # comma separated; only needed for cross-origin dev setups
COOKIE_SECURE=false                     # set true when served over HTTPS (required in production)
SESSION_TTL_DAYS=14
ENABLE_DOCS=false                       # OpenAPI UI at /api/docs
TRUST_PROXY_HEADERS=false               # true behind a reverse proxy that sets X-Forwarded-For
REGISTER_LIMIT_PER_HOUR=10              # sign-ups per IP per hour

# --- Local AI (Ollama) ---------------------------------------------------------
LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30

# --- Background worker ---------------------------------------------------------
RUN_WORKER_IN_API=false                 # true runs reminders inside the API process (single-process dev)
WORKER_INTERVAL_SECONDS=30

# --- Behaviour & retention -----------------------------------------------------
NEGLECT_DAYS=14
ACTIVITY_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
TOMBSTONE_RETENTION_DAYS=90
MAX_IMPORT_BYTES=1000000
